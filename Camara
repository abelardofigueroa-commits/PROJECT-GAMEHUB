using UnityEngine;

public class CameraFollow : MonoBehaviour
{
    public Transform Player;

    void Start()
    {

    }

    void Update()
    {
        FollowPlayer();
    }

    public void FollowPlayer()
    {
        Vector3 CameraPosition = Player.position;

        CameraPosition.z = -10;

        transform.position = CameraPosition;
    }
}
